# Existing Supabase settings (optional until admin/database is connected)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public production URL, e.g. https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Secure email delivery — no extra npm package required
# Create a Resend API key and verify the FROM domain before production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Ella Floating View <bookings@your-verified-domain.com>

# Optional but strongly recommended anti-bot protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
